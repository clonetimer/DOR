{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m2n://schemas/device_card.schema.json",
  "title": "M2N Device Card v2.16",
  "type": "object",
  "required": [
    "schema_version",
    "template",
    "data",
    "mechanism",
    "knowledge",
    "supervision"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "2.0",
        "2.1",
        "2.2",
        "2.3",
        "2.4",
        "2.5",
        "2.6",
        "2.7",
        "2.8",
        "2.9",
        "2.10",
        "2.11",
        "2.12",
        "2.13",
        "2.14",
        "2.15",
        "2.16"
      ]
    },
    "template": {
      "enum": [
        "second_order_mechanics",
        "separable_peak_response",
        "generic_mechanism_graph"
      ]
    },
    "goal": {
      "type": "object"
    },
    "data": {
      "type": "object",
      "properties": {
        "split_column": {
          "type": "string"
        },
        "train_values": {
          "type": "array"
        },
        "validation_values": {
          "type": "array"
        },
        "time_column": {
          "type": "string",
          "description": "Optional local time coordinate; when independent_context_column is declared, monotonicity is checked within each context."
        }
      },
      "additionalProperties": true
    },
    "mechanism": {
      "type": "object"
    },
    "knowledge": {
      "type": "object"
    },
    "supervision": {
      "type": "object"
    },
    "qualification": {
      "type": "object",
      "properties": {
        "independent_context_column": {
          "type": "string"
        },
        "evidence_scope": {
          "enum": [
            "PRODUCTION",
            "BLINDED_FOR_VALIDATION"
          ],
          "default": "PRODUCTION"
        },
        "min_train_independent_contexts": {
          "type": "integer",
          "minimum": 1
        },
        "min_validation_independent_contexts": {
          "type": "integer",
          "minimum": 1
        },
        "min_train_rows": {
          "type": "integer",
          "minimum": 1
        },
        "min_validation_rows": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "training": {
      "type": "object"
    },
    "selection": {
      "type": "object"
    },
    "backends": {
      "type": "object"
    },
    "k3_policy": {
      "type": "object"
    },
    "physics_biases": {
      "type": "array"
    },
    "bias_policy": {
      "type": "object"
    },
    "task_semantics": {
      "type": "object"
    },
    "modeling_contract": {
      "type": "object",
      "description": "Optional modeling-only contract used by m2n model-plan and qualified design paths. It does not encode fault ontology, evidence calibration or diagnosis semantics.",
      "required": [
        "objective",
        "input_representation"
      ],
      "properties": {
        "objective": {
          "enum": [
            "STATIC_REGRESSION",
            "NORMALITY_MODELING",
            "CATEGORICAL_PREDICTION",
            "DYNAMICS_IDENTIFICATION",
            "OPERATOR_LEARNING"
          ]
        },
        "input_representation": {
          "enum": [
            "TABULAR",
            "MULTIVARIATE_SEQUENCE",
            "WAVEFORM_SEQUENCE",
            "FUNCTION",
            "REGULAR_GRID_FIELD"
          ]
        },
        "mechanism_usage": {
          "enum": [
            "REQUIRED",
            "PREFERRED",
            "OPTIONAL",
            "NONE"
          ],
          "default": "OPTIONAL"
        },
        "prediction_unit": {
          "type": "string"
        },
        "input_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label_column": {
          "type": "string"
        },
        "time_column": {
          "type": "string"
        },
        "required_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "representation_candidates": {
              "type": "array",
              "minItems": 1,
              "description": "Optional first-class representation candidates. v2.15 parameterizes deterministic waveform FEATURE/ORDER candidates so multiple same-kind representations can compete under independent validation.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "waveform_representation"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "WAVEFORM_FEATURE_LINEAR",
                      "WAVEFORM_ORDER_LINEAR"
                    ]
                  },
                  "waveform_representation": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            },
            "forecast_evaluation": {
              "type": "object",
              "description": "Optional v2.16 forecast-horizon qualification. Legacy default is ONE_STEP/horizon=1. RECURSIVE_ROLLOUT initially supports only closed DYNAMICS_IDENTIFICATION states where input_columns == target_columns; future exogenous inputs are never fabricated.",
              "properties": {
                "mode": {
                  "enum": [
                    "ONE_STEP",
                    "RECURSIVE_ROLLOUT"
                  ]
                },
                "horizon_steps": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
