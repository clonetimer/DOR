{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DOR-PUBLIC-DIAGNOSTIC-DATASET-CATALOG/1.0",
  "type": "object",
  "required": ["contract", "last_verified_on", "datasets"],
  "properties": {
    "contract": {"const": "DOR-PUBLIC-DIAGNOSTIC-DATASET-CATALOG/1.0"},
    "last_verified_on": {"type": "string", "format": "date"},
    "datasets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset_id", "name", "official_landing_page", "primary_references", "access", "stage_evidence", "dor_support", "validation", "adapter", "prohibited_claims"]
      }
    }
  }
}
