{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DOR-MULTIMODAL-DATASET-MANIFEST/1.0",
  "title": "DOR tabular and multichannel time-series manifest",
  "type": "object",
  "required": ["contract", "dataset_id", "modality", "split", "supervision"],
  "properties": {
    "contract": {"const": "DOR-MULTIMODAL-DATASET-MANIFEST/1.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "modality": {"enum": ["TABULAR", "TIMESERIES_LONG", "TIMESERIES_NPZ"]},
    "identifiers": {"type": "array", "items": {"type": "string"}},
    "features": {"type": "object"},
    "timeseries": {"type": "object"},
    "split": {
      "type": "object",
      "required": ["column", "train_values", "validation_values"],
      "properties": {
        "column": {"type": "string"},
        "train_values": {"type": "array", "minItems": 1},
        "validation_values": {"type": "array", "minItems": 1},
        "calibration_values": {"type": "array"}, "test_values": {"type": "array"}
      }
    },
    "supervision": {
      "type": "object",
      "properties": {
        "detection": {"type": "object"}, "localization": {"type": "object"},
        "classification": {"type": "object"}, "identification": {"type": "object"}
      }
    },
    "leakage_guard": {"type": "object"}
  },
  "additionalProperties": true
}
