{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOR Fault Identification Result v0.7",
  "type": "object",
  "required": ["contract", "status", "reason", "identifications", "safety"],
  "properties": {
    "contract": {"const": "DOR-FAULT-IDENTIFICATION-RESULT/0.7"},
    "status": {"enum": ["SUPPORTED", "ALTERNATIVES", "UNKNOWN", "ABSTAIN"]},
    "reason": {"type": "string"},
    "candidate_source": {"type": "string"},
    "candidate_fault_ids": {"type": "array", "items": {"type": "string"}},
    "identifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "identification_type", "identified_change", "basis", "support_evidence", "reason"],
        "properties": {
          "fault_id": {"type": ["string", "null"]},
          "component_id": {"type": ["string", "null"]},
          "category": {"type": "string"},
          "status": {"enum": ["SUPPORTED", "ALTERNATIVES", "UNKNOWN", "ABSTAIN"]},
          "identification_type": {"type": "string"},
          "identified_change": {"type": "object"},
          "basis": {"type": "string"},
          "support_evidence": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "isgn_admission": {"type": "object"},
    "safety": {"type": "object", "required": ["physical_change_claimed", "root_cause_implied", "isgn_required_for_parametric_or_structure_claims"]}
  }
}
