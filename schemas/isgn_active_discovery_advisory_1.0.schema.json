{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dor.local/schemas/isgn_active_discovery_advisory_1.0.schema.json",
  "title": "DOR ISGN Active Discovery Advisory 1.0",
  "type": "object",
  "required": [
    "contract",
    "status",
    "candidate_structures",
    "posterior_mass_sum",
    "identifiability_status",
    "evidence_stability_status",
    "hypothesis_space_coverage_complete",
    "remaining_discriminating_experiments",
    "admission_issues",
    "safety",
    "reason"
  ],
  "properties": {
    "contract": {
      "const": "DOR-ISGN-ACTIVE-DISCOVERY-ADVISORY/1.0"
    },
    "status": {
      "enum": ["ADVISORY_ONLY", "BLOCKED"]
    },
    "candidate_structures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["structure_id", "posterior_mass"],
        "properties": {
          "structure_id": {"type": "string", "minLength": 1},
          "posterior_mass": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "posterior_mass_sum": {"type": "number", "minimum": 0, "maximum": 1.000001},
    "next_experiment": {
      "type": ["object", "null"],
      "properties": {
        "experiment_id": {"type": "string"},
        "execution_mode": {"enum": ["ADVISORY_ONLY", "OFFLINE_REPLAY", "SIMULATION", "LIVE"]},
        "repeats": {"type": "integer", "minimum": 0},
        "cost": {"type": ["number", "null"]},
        "safety_eligible": {"type": "boolean"},
        "execution_allowed": {"const": false}
      },
      "required": ["experiment_id", "execution_mode", "repeats", "cost", "safety_eligible", "execution_allowed"],
      "additionalProperties": false
    },
    "predictive_adequacy": {
      "type": ["object", "null"],
      "properties": {
        "status": {"enum": ["ADEQUATE", "HYPOTHESIS_CLASS_INADEQUATE"]},
        "truth_channels_allowed": {"const": false},
        "min_mahalanobis": {"type": "number", "minimum": 0},
        "threshold": {"type": "number", "minimum": 0},
        "nearest_structure": {"type": "string", "minLength": 1},
        "nearest_particle": {"type": "string", "minLength": 1}
      },
      "required": ["status", "truth_channels_allowed"],
      "additionalProperties": false
    },
    "identifiability_status": {
      "type": ["string", "null"],
      "enum": ["UNIQUE_SUPPORTED", "ALTERNATIVES", "UNIDENTIFIABLE", "HYPOTHESIS_CLASS_INADEQUATE", null]
    },
    "evidence_stability_status": {
      "type": ["string", "null"],
      "enum": ["STABLE", "UNSTABLE", "INSUFFICIENT", null]
    },
    "hypothesis_space_coverage_complete": {"type": "boolean"},
    "remaining_discriminating_experiments": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "admission_issues": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "safety": {
      "type": "object",
      "required": [
        "truth_channels_allowed",
        "truth_quarantine_verified",
        "diagnostic_claim_allowed",
        "fault_identification_allowed",
        "root_cause_claim_allowed",
        "mechanism_identity_certified",
        "proposal_is_evidence",
        "experiment_execution_allowed",
        "raw_experiment_payload_forwarded"
      ],
      "properties": {
        "truth_channels_allowed": {"const": false},
        "truth_quarantine_verified": {"type": "boolean"},
        "diagnostic_claim_allowed": {"const": false},
        "fault_identification_allowed": {"const": false},
        "root_cause_claim_allowed": {"const": false},
        "mechanism_identity_certified": {"const": false},
        "proposal_is_evidence": {"const": false},
        "experiment_execution_allowed": {"const": false},
        "raw_experiment_payload_forwarded": {"const": false}
      },
      "additionalProperties": false
    },
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ADVISORY_ONLY"}}},
      "then": {
        "properties": {
          "admission_issues": {"maxItems": 0},
          "posterior_mass_sum": {"minimum": 0.999999, "maximum": 1.000001},
          "safety": {"properties": {"truth_quarantine_verified": {"const": true}}}
        }
      }
    }
  ],
  "additionalProperties": false
}
