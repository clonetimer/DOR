{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOR Fault Identification Request v0.7",
  "type": "object",
  "required": ["contract", "status", "reason", "candidate_fault_ids", "routes", "window_authorization", "engine_admissions", "safety"],
  "properties": {
    "contract": {"const": "DOR-FAULT-IDENTIFICATION-REQUEST/0.7"},
    "status": {"enum": ["PLANNED", "BLOCKED"]},
    "reason": {"type": "string"},
    "case_id": {"type": ["string", "null"]},
    "candidate_source": {"type": "string"},
    "candidate_fault_ids": {"type": "array", "items": {"type": "string"}},
    "routes": {"type": "array", "items": {"type": "object", "required": ["fault_id", "route", "reason"]}},
    "window_authorization": {"type": "object", "required": ["start", "end", "evidence_validity"]},
    "engine_admissions": {"type": "object", "required": ["ISGN"]},
    "artifact_bindings": {"type": "object"},
    "safety": {"type": "object"}
  }
}
