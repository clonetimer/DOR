{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOR adapter contract for ISGN identification evidence v0.7",
  "type": "object",
  "required": [
    "contract",
    "status",
    "baseline_certificate_status",
    "window_evidence_validity",
    "changes"
  ],
  "properties": {
    "contract": {
      "const": "DOR-ISGN-IDENTIFICATION-EVIDENCE/0.7"
    },
    "status": {
      "enum": [
        "SUPPORTED",
        "ALTERNATIVES",
        "UNIDENTIFIABLE",
        "UNSUPPORTED"
      ]
    },
    "baseline_certificate_status": {
      "type": "string"
    },
    "window_evidence_validity": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "change_type",
          "identifiable",
          "supported",
          "provenance"
        ]
      }
    }
  }
}
