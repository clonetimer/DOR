  "properties": {
    "contract": {"const": "DOR-DIAGNOSTIC-PLAN/0.4"},
    "plan_id": {"type": "string", "pattern": "^dor04-"},
    "task": {"type": "string"},
    "qualification": {"type": "object"},
    "engine_admissions": {"type": "array"},
    "steps": {"type": "array", "minItems": 1},
    "provenance": {"type": "object"}
  }
}
